# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave blank or specify a valid MongoDB URI (e.g. mongodb://127.0.0.1:27017/campus_vote)
# If left blank and no local MongoDB is running, the backend seamlessly boots an embedded in-memory MongoDB instance for development!
MONGO_URI=mongodb://127.0.0.1:27017/campus_vote

# JWT Authentication Secret
JWT_SECRET=super_secret_university_campus_vote_jwt_key_2026

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
